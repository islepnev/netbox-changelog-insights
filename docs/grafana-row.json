{
  "__comment": "Row of panels for the NetBox dashboard: copy \"panels\" into the dashboard panels and \"templating\" into templating.list. Data source: Infinity, with its URL set to the NetBox base URL and the header \"Authorization: Bearer nbt_<key>.<token>\" (a token of a user with core.view_objectchange). Endpoint: GET /api/plugins/changelog-insights/activity/.",
  "templating": {
    "list": [
      {
        "name": "infinity",
        "label": "NetBox API (Infinity)",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "ci_bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "day,week",
        "hide": 0,
        "current": {
          "text": "day",
          "value": "day"
        },
        "options": [
          {
            "text": "day",
            "value": "day",
            "selected": true
          },
          {
            "text": "week",
            "value": "week",
            "selected": false
          }
        ]
      },
      {
        "name": "ci_kind",
        "label": "Actor kind",
        "type": "custom",
        "query": "person,automation",
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "person",
            "value": "person",
            "selected": false
          },
          {
            "text": "automation",
            "value": "automation",
            "selected": false
          }
        ],
        "includeAll": true,
        "allValue": "all",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "NetBox changes (changelog-insights)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Changes in range",
      "id": 101,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "description": "Sum over the dashboard range, in whole days of the NetBox TIME_ZONE. A change set is the records of one request; primary changes leave out side effects (folded records).",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${infinity}"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/plugins/changelog-insights/activity/",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "group",
                "value": "day"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "kind",
                "value": "${ci_kind}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "change_sets",
              "text": "Change sets",
              "type": "number"
            },
            {
              "selector": "changes",
              "text": "Primary changes",
              "type": "number"
            },
            {
              "selector": "records",
              "text": "Records",
              "type": "number"
            },
            {
              "selector": "created",
              "text": "Created",
              "type": "number"
            },
            {
              "selector": "updated",
              "text": "Updated",
              "type": "number"
            },
            {
              "selector": "deleted",
              "text": "Deleted",
              "type": "number"
            }
          ],
          "filters": []
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^(Change sets|Primary changes|Records)$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Change sets per ${ci_bucket}",
      "id": 102,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "description": "Change sets and primary changes per day or week (weeks start on Monday). Partial first and last buckets hold fewer days.",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${infinity}"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/api/plugins/changelog-insights/activity/",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "group",
                "value": "${ci_bucket}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "kind",
                "value": "${ci_kind}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "change_sets",
              "text": "Change sets",
              "type": "number"
            },
            {
              "selector": "changes",
              "text": "Primary changes",
              "type": "number"
            },
            {
              "selector": "created",
              "text": "Created",
              "type": "number"
            },
            {
              "selector": "updated",
              "text": "Updated",
              "type": "number"
            },
            {
              "selector": "deleted",
              "text": "Deleted",
              "type": "number"
            }
          ],
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Primary changes|Created|Updated|Deleted)$"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": false,
                  "viz": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Change sets"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "table",
      "title": "Top users",
      "id": 103,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
